{
  "name": "app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/predev.mjs",
    "build": "node scripts/build-math.mjs && tsc && vite build",
    "test": "node scripts/build-math.mjs && bun test tests scripts/*.test.mjs",
    "preview": "vite preview",
    "ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "speech": "node scripts/build-speech.mjs",
    "whisper": "node scripts/build-whisper.mjs",
    "editor-wasm": "node scripts/build-editor-wasm.mjs",
