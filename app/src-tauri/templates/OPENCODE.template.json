{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "subagent_depth": 0,
  "permission": {
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "external_directory": "allow",
    "task": "deny",
    "question": "deny",
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "deny",
    "edit": {
      "*": "allow",
      "{{LIBRARY}}/courses/**": "deny",
      "{{LIBRARY}}/lectures/**": "deny",
      "{{LIBRARY}}/canvas-session/**": "deny",
      "{{LIBRARY}}/oculus.db*": "deny",
      "{{LIBRARY}}/*.cookie": "deny",
      "{{LIBRARY}}/*.token": "deny",
      "{{LIBRARY}}/*.json": "deny",
      "{{LIBRARY}}/*.log": "deny",
      "opencode.json": "deny"
    },
    "bash": {
      "*": "deny",
      "ls": "allow",
      "ls *": "allow",
      "oculus": "allow",
      "oculus *": "allow"
    }
  },
  "agent": {
    "oculus": {
      "mode": "primary",
      "description": "The Oculus coursework agent",
      "prompt": "{{PROMPT}}"
    },
    "oculus-namer": {
      "mode": "primary",
      "hidden": true,
      "description": "Names one conversation",
      "prompt": "{{NAMING_PROMPT}}"
    }
  }
}
