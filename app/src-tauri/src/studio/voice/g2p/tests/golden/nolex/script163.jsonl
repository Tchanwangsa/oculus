{"id": "s07", "text": "Pick it too large and you overshoot the valley, bouncing from wall to wall.", "phonemes": "pˈɪk ɪt tˈu lˈɑɹʤ ænd ju ˌOvəɹʃˈut ðə vˈæli, bˈWnsɪŋ fɹʌm wˈɔl tə wˈɔl.", "words": [{"word": "Pick", "phonemes": "pˈɪk", "source": "dict"}, {"word": "it", "phonemes": "ɪt", "source": "dict"}, {"word": "too", "phonemes": "tˈu", "source": "dict"}, {"word": "large", "phonemes": "lˈɑɹʤ", "source": "dict"}, {"word": "and", "phonemes": "ænd", "source": "dict"}, {"word": "you", "phonemes": "ju", "source": "dict"}, {"word": "overshoot", "phonemes": "ˌOvəɹʃˈut", "source": "rule"}, {"word": "the", "phonemes": "ðə", "source": "dict"}, {"word": "valley", "phonemes": "vˈæli", "source": "dict"}, {"word": "bouncing", "phonemes": "bˈWnsɪŋ", "source": "dict"}, {"word": "from", "phonemes": "fɹʌm", "source": "dict"}, {"word": "wall", "phonemes": "wˈɔl", "source": "dict"}, {"word": "to", "phonemes": "tə", "source": "dict"}, {"word": "wall", "phonemes": "wˈɔl", "source": "dict"}]}
