{"id": "s05", "text": "Each step nudges every weight in the direction that lowers the loss.", "phonemes": "ˈiʧ stˈɛp nˈʌʤᵻz ˈɛvəɹi wˈAt ɪn ðə dəɹˈɛkʃən ðæt lˈOəɹz ðə lˈɔs.", "words": [{"word": "Each", "phonemes": "ˈiʧ", "source": "dict"}, {"word": "step", "phonemes": "stˈɛp", "source": "dict"}, {"word": "nudges", "phonemes": "nˈʌʤᵻz", "source": "dict"}, {"word": "every", "phonemes": "ˈɛvəɹi", "source": "dict"}, {"word": "weight", "phonemes": "wˈAt", "source": "dict"}, {"word": "in", "phonemes": "ɪn", "source": "dict"}, {"word": "the", "phonemes": "ðə", "source": "dict"}, {"word": "direction", "phonemes": "dəɹˈɛkʃən", "source": "dict"}, {"word": "that", "phonemes": "ðæt", "source": "dict"}, {"word": "lowers", "phonemes": "lˈOəɹz", "source": "dict"}, {"word": "the", "phonemes": "ðə", "source": "dict"}, {"word": "loss", "phonemes": "lˈɔs", "source": "dict"}]}
