{"id": "s01", "text": "Gradient descent is how a neural network learns.", "phonemes": "ɡɹˈAdiənt dəsˈɛnt ɪz hˌW ɐ nˈʊɹᵊl nˈɛtwˌɜɹk lˈɜɹnz.", "words": [{"word": "Gradient", "phonemes": "ɡɹˈAdiənt", "source": "dict"}, {"word": "descent", "phonemes": "dəsˈɛnt", "source": "dict"}, {"word": "is", "phonemes": "ɪz", "source": "dict"}, {"word": "how", "phonemes": "hˌW", "source": "dict"}, {"word": "a", "phonemes": "ɐ", "source": "dict"}, {"word": "neural", "phonemes": "nˈʊɹᵊl", "source": "dict"}, {"word": "network", "phonemes": "nˈɛtwˌɜɹk", "source": "dict"}, {"word": "learns", "phonemes": "lˈɜɹnz", "source": "dict"}]}
{"id": "s02", "text": "Imagine standing on a foggy hillside and wanting to reach the valley floor.", "phonemes": "ɪmˈæʤən stˈændɪŋ ˌɔn ɐ fˈɔɡi hˈɪlsˌId ænd wˈɑnttɪŋ tə ɹˈiʧ ðə vˈæli flˈɔɹ.", "words": [{"word": "Imagine", "phonemes": "ɪmˈæʤən", "source": "dict"}, {"word": "standing", "phonemes": "stˈændɪŋ", "source": "dict"}, {"word": "on", "phonemes": "ˌɔn", "source": "dict"}, {"word": "a", "phonemes": "ɐ", "source": "dict"}, {"word": "foggy", "phonemes": "fˈɔɡi", "source": "dict"}, {"word": "hillside", "phonemes": "hˈɪlsˌId", "source": "dict"}, {"word": "and", "phonemes": "ænd", "source": "dict"}, {"word": "wanting", "phonemes": "wˈɑnttɪŋ", "source": "dict"}, {"word": "to", "phonemes": "tə", "source": "dict"}, {"word": "reach", "phonemes": "ɹˈiʧ", "source": "dict"}, {"word": "the", "phonemes": "ðə", "source": "dict"}, {"word": "valley", "phonemes": "vˈæli", "source": "dict"}, {"word": "floor", "phonemes": "flˈɔɹ", "source": "dict"}]}
{"id": "s03", "text": "You cannot see the whole landscape, so you feel the slope under your feet and take a small step downhill.", "phonemes": "jˌu kənˈɑt sˈi ðə hˈOl lˈændskˌAp, sˌO ju fˈil ðə slˈOp ˈʌndəɹ jʊɹ fˈit ænd tˈAk ɐ smˈɔl stˈɛp dˌWnhˈɪl.", "words": [{"word": "You", "phonemes": "jˌu", "source": "dict"}, {"word": "cannot", "phonemes": "kənˈɑt", "source": "dict"}, {"word": "see", "phonemes": "sˈi", "source": "dict"}, {"word": "the", "phonemes": "ðə", "source": "dict"}, {"word": "whole", "phonemes": "hˈOl", "source": "dict"}, {"word": "landscape", "phonemes": "lˈændskˌAp", "source": "dict"}, {"word": "so", "phonemes": "sˌO", "source": "dict"}, {"word": "you", "phonemes": "ju", "source": "dict"}, {"word": "feel", "phonemes": "fˈil", "source": "dict"}, {"word": "the", "phonemes": "ðə", "source": "dict"}, {"word": "slope", "phonemes": "slˈOp", "source": "dict"}, {"word": "under", "phonemes": "ˈʌndəɹ", "source": "dict"}, {"word": "your", "phonemes": "jʊɹ", "source": "dict"}, {"word": "feet", "phonemes": "fˈit", "source": "dict"}, {"word": "and", "phonemes": "ænd", "source": "dict"}, {"word": "take", "phonemes": "tˈAk", "source": "dict"}, {"word": "a", "phonemes": "ɐ", "source": "dict"}, {"word": "small", "phonemes": "smˈɔl", "source": "dict"}, {"word": "step", "phonemes": "stˈɛp", "source": "dict"}, {"word": "downhill", "phonemes": "dˌWnhˈɪl", "source": "dict"}]}
