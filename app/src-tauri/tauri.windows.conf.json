{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Oculus",
        "width": 1480,
        "height": 920,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "assetProtocol": {
        "scope": [
          "$HOME/Oculus/courses/**",
          "$HOME/Oculus/lectures/**",
          "$HOME/Oculus/agents/**"
        ]
      }
    }
  },
  "bundle": {
    "icon": [
      "windows/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/oculus",
      "binaries/oculus-keyd"
    ],
    "resources": {
      "ffmpeg-notices/FFMPEG-LICENSE.txt": "FFMPEG-LICENSE.txt",
      "ffmpeg-notices/FFMPEG-README.txt": "FFMPEG-README.txt",
      "../../LICENSE": "LICENSE"
    }
  },
  "mainBinaryName": "oculus-app"
}
