{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oculus",
  "version": "0.1.0",
  "identifier": "com.tchan.oculus",
  "build": {
    "beforeDevCommand": "OCULUS_CLI_WATCH=1 bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run ffmpeg && bun run pdfium && bun run stage-cli && bun run docs:cli && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Oculus",
        "width": 1480,
        "height": 920,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 27.5
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/courses/**",
          "$APPDATA/lectures/**",
          "$APPDATA/agents/attachments/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/oculus"
    ],
    "macOS": {
      "frameworks": [
        "binaries/libpdfium.dylib"
      ]
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}