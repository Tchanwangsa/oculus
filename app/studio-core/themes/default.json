    "h1": { "fontFamily": "Manrope", "fontSize": 72, "fontWeight": 700, "lineHeight": 1.08, "letterSpacing": -1.8 },
    "h2": { "fontFamily": "Manrope", "fontSize": 52, "fontWeight": 650, "lineHeight": 1.12, "letterSpacing": -1.0 },
    "h3": { "fontFamily": "Manrope", "fontSize": 38, "fontWeight": 600, "lineHeight": 1.2, "letterSpacing": -0.5 },
    "body": { "fontFamily": "Inter", "fontSize": 32, "fontWeight": 420, "lineHeight": 1.45, "letterSpacing": -0.2 },
    "label": { "fontFamily": "Inter", "fontSize": 24, "fontWeight": 600, "lineHeight": 1.2, "letterSpacing": 0.2 },
